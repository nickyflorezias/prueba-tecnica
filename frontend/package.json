{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n token,web \"node dev/token-server.mjs\" \"ng serve\"",
    "build": "ng build",
    "test": "ng test --no-watch --no-progress",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "test:a11y": "playwright test",
    "test:all": "npm run lint:arch && npm test && npm run build && npm run test:a11y"
  },
  "private": true,
  "packageManager": "npm@12.2.1",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "axe-core": "^4.14.1",
    "concurrently": "^10.0.7",
    "dependency-cruiser": "^18.9.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
